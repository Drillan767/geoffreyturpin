{
    "version": 2,
    "sql": [
        {
            "engine": "mysql",
            "queries": "queries/",
            "schema": "../database/migrations/",
            "gen": {
                "go": {
                    "package": "repository",
                    "out": "generated",
                    "emit_json_tags": true,
                    "emit_interface": true,
                    "emit_empty_slices": true
                }
            }
        }
    ]
}
